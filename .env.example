# Groq API (get free key from https://console.groq.com/keys)
GROQ_API_KEY=groq_key_here

# HuggingFace API (get free token from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_token_here

# Model Configuration
MODEL_NAME=llama-3.3-70b-versatile
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000